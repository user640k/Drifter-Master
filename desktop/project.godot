; Drift Master, desktop version (Godot 4.6, C#)
config_version=5

[application]

config/name="Drift Master"
run/main_scene="res://Main.tscn"
config/icon="res://icon_256.png"
config/windows_native_icon="res://icon.ico"
config/features=PackedStringArray("4.6", "C#", "GL Compatibility")
run/max_fps=0
boot_splash/show_image=false
boot_splash/bg_color=Color(0, 0, 0, 1)

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[dotnet]

project/assembly_name="DriftMaster"

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
anti_aliasing/quality/msaa_3d=1
lights_and_shadows/directional_shadow/size=2048
lights_and_shadows/directional_shadow/soft_shadow_filter_quality=1
textures/default_filters/anisotropic_filtering_level=3
